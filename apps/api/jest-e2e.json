{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e.spec.ts"],
  "transform": {
    "^.+\\.(ts|tsx)$": ["ts-jest", { "isolatedModules": true }]
  },
  "setupFilesAfterEnv": ["./test/setup-tests.e2e.ts"],
  "setupFiles": [
    "./test/setup-env.e2e.ts"
  ]
}