{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@denali/typescript-config/nextjs.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "@/web/*": ["./*"],
      "@/js/*": ["./src/js/*"],
      "@/app/*": ["./src/app/*"],
      "@/css/*": ["./src/css/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/types/*": ["./src/types/*"],
      "@/auth0-config": ["./src/auth0-config.ts"],
      "@/config/*": ["./src/config/*"],

      "@/shared/*": ["../../packages/shared/src/*"],
      "@/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    "tailwind.config.js",
    "tests",
    "jest.config.ts",
    "cypress",
    "cypress.config.ts"
  ],
  "plugins": [{ "name": "next" }]
}
