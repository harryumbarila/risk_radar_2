{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@denali/typescript-config/nextjs.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "ui/*": ["./src/ui/*"],
      "constants/*": ["./src/constants/*"],
      "config/*": ["./src/config/*"],
      "data/*": ["./src/data/*"],
      "libs/*": ["./src/libs/*"],
      "types/*": ["./src/types/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
