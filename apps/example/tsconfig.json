{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@denali/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/example/*": ["./*"],
      "@/js/*": ["./src/js/*"],
      "@/app/*": ["./src/app/*"],
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/types/*": ["./src/types/*"],
      "@/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    "tailwind.config.js",
    ".next/types/**/*.ts"
  ],
  "plugins": [{ "name": "next" }]
}
