{
  "name": "daneli",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "configs/*",
    "db/*"
  ],
  "scripts": {
    "build": "turbo build",
    "commit": "git-cz",
    "create-db-pkg": "node configs/toolkit/add-db-package.js",
    "dev": "turbo dev",
    "docs": "yarn workspace @denali/docs run dev-docs",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky",
    "start:api": "turbo run start --filter=@denali/api",
    "start:web": "turbo run start --filter=@denali/web",
    "sync-packages": "syncpack fix-mismatches",
    "test:e2e": "turbo run test:e2e",
    "test:unit": "turbo run test:unit",
    "type-check": "turbo run type-check"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "useEmoji": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^19.8.1",
    "@denali/eslint-config": "*",
    "@denali/shared": "*",
    "@denali/typescript-config": "*",
    "@ls-lint/ls-lint": "^2.3.0",
    "cross-env": "^7.0.3",
    "cz-git": "^1.11.0",
    "dotenv-cli": "^8.0.0",
    "git-cz": "^4.9.0",
    "husky": "^9.0.11",
    "jscodeshift": "^17.3.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "syncpack": "^13.0.4",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.21"
}