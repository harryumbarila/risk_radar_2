{
  "name": "daneli",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "configs/*",
    "db/*"
  ],
  "scripts": {
    "add:component": "npx hygen component new",
    "build": "turbo build",
    "commit": "git-cz",
    "dev": "turbo dev",
    "docs": "yarn workspace @denali/docs run dev-docs",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky",
    "start:api": "turbo run start --filter=@denali/api",
    "start:web": "turbo run start --filter=@denali/web",
    "sync-packages": "syncpack fix-mismatches",
    "test:e2e": "turbo run test:e2e",
    "test:unit": "turbo run test:unit",
    "type-check": "turbo run type-check"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "useEmoji": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@denali/eslint-config": "*",
    "@denali/shared": "*",
    "@denali/typescript-config": "*",
    "@ls-lint/ls-lint": "^2.3.1",
    "cross-env": "^10.1.0",
    "cz-git": "^1.12.0",
    "dotenv-cli": "^10.0.0",
    "enquirer": "^2.4.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "jscodeshift": "^17.3.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "syncpack": "^13.0.4",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "cookie": "^1.0.2",
    "tmp": "^0.2.5"
  }
}