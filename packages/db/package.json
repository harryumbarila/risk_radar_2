{
  "name": "@denali/db",
  "description": "TypeORM database integration",
  "version": "1.0.0",
  "dependencies": {
    "@denali/logger": "*",
    "@nestjs/typeorm": "^11.0.0",
    "@t3-oss/env-core": "^0.6.1",
    "mssql": "^11.0.1",
    "ts-jest": "^29.2.4",
    "typeorm": "^0.3.21",
    "typeorm-extension": "^3.7.0",
    "typeorm-fixtures-cli": "^4.1.0",
    "typeorm-naming-strategy": "^2.0.12",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@denali/eslint-config": "*",
    "@denali/jest-config": "*",
    "@denali/typescript-config": "*",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "fixtures": "ts-node -r ts-node/register/esm ts-node/esm src/fixtures.ts",
    "lint": "eslint --ext .ts --max-warnings=0 .",
    "type-check": "tsc --noEmit",
    "typeorm": "node --require ts-node/register ../../node_modules/typeorm/cli.js",
    "typeorm:create-migration": "node --require ts-node/register ../../node_modules/typeorm/cli.js migration:generate -o -d ./src/config/cli-data-source.ts",
    "typeorm:migrate": "node --require ts-node/register ../../node_modules/typeorm/cli.js migration:run -d ./src/config/cli-data-source.ts",
    "typeorm:revert-migration": "node --require ts-node/register ../../node_modules/typeorm/cli.js migration:revert -d ./src/config/cli-data-source.ts"
  },
  "types": "./src/index.ts"
}
