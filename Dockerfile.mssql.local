FROM mcr.microsoft.com/mssql/server:2019-latest

USER root

# Install SQL Server tools and dependencies
RUN apt-get update && \
    ACCEPT_EULA=Y apt-get install -y mssql-tools unixodbc-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy initialization script
COPY init-db/01-init-databases.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/01-init-databases.sh

USER mssql

ENV ACCEPT_EULA=Y \
    SA_PASSWORD=Denali123! \
    MSSQL_PID=Express \
    MSSQL_AGENT_ENABLED=true \
    MSSQL_TCP_PORT=1433

# Start SQL Server and run initialization
CMD /bin/bash -c '/opt/mssql/bin/sqlservr & \
    pid=$! && \
    echo "[$(date)] Waiting for SQL Server to start..." && \
    for i in {1..60}; do \
        if /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P "$SA_PASSWORD" -Q "SELECT 1" &>/dev/null; then \
            echo "[$(date)] SQL Server is ready" && \
            /usr/local/bin/01-init-databases.sh && \
            break; \
        fi; \
        echo "[$(date)] Attempt $i: SQL Server not ready yet..."; \
        sleep 5; \
    done & \
    wait $pid' 
