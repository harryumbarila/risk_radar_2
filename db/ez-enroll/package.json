{
  "name": "@denali/ez-enroll-db",
  "description": "TypeORM Example database integration",
  "version": "0.0.0",
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/typeorm": "^11.0.0",
    "@t3-oss/env-core": "^0.6.1",
    "mssql": "^11.0.1",
    "pg": "^8.16.3",
    "ts-jest": "^29.4.0",
    "typeorm": "^0.3.25",
    "typeorm-extension": "^3.7.1",
    "typeorm-fixtures-cli": "^4.1.0",
    "typeorm-naming-strategy": "^2.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@denali/eslint-config": "*",
    "@denali/jest-config": "*",
    "@denali/typescript-config": "*",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "db:fixtures": "fixtures-ts-node-commonjs --dataSource=./src/connection/cli-data-source.ts load ./fixtures --sync --require=@denali/ez-enroll-db",
    "db:generate": "dotenv -e ../apps/api/.env -- npm run typeorm -- migration:generate -o -d ./src/connection/cli-data-source.ts",
    "db:migrate": "dotenv -e ../apps/api/.env -- npm run typeorm -- migration:run -d ./src/connection/cli-data-source.ts",
    "db:revert": "dotenv -e ../apps/api/.env -- npm run typeorm -- migration:revert -d ./src/connection/cli-data-source.ts",
    "lint": "eslint --ext .ts --max-warnings=0 .",
    "type-check": "tsc --noEmit",
    "typeorm": "dotenv -e ../apps/api/.env -- node --require ts-node/register ../../node_modules/typeorm/cli.js"
  },
  "types": "./src/index.ts"
}