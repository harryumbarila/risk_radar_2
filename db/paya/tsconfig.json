{
  "extends": "@denali/typescript-config/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node", "jest"],
    "paths": {
      "@/db/*": ["./src/*"],
      "@/logger/*": ["../../packages/logger/src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": ["src", "tests", "jest.config.ts", "jest.setup.ts"],
  "exclude": ["node_modules"]
}
