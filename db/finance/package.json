{
  "name": "@denali/finance-db",
  "description": "TypeORM Finance database integration",
  "version": "0.0.0",
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@t3-oss/env-core": "^0.13.8",
    "mssql": "^12.0.0",
    "pg": "^8.16.3",
    "ts-jest": "^29.4.5",
    "typeorm": "^0.3.27",
    "typeorm-extension": "^3.7.1",
    "typeorm-fixtures-cli": "^4.1.0",
    "typeorm-naming-strategy": "^2.0.14",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@denali/eslint-config": "*",
    "@denali/jest-config": "*",
    "@denali/typescript-config": "*",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "typescript": "^5.9.3"
  },
  "main": "./src/index.ts",
  "private": true,
  "scripts": {
    "db:fixtures": "fixtures-ts-node-commonjs --dataSource=./src/connection/cli-data-source.ts load ./fixtures --sync --require=@denali/finance-db",
    "db:generate": "dotenv -e ../apps/api/.env -- npm run typeorm -- migration:generate -o -d ./src/connection/cli-data-source.ts",
    "db:migrate": "dotenv -e ../apps/api/.env -- npm run typeorm -- migration:run -d ./src/connection/cli-data-source.ts",
    "db:revert": "dotenv -e ../apps/api/.env -- npm run typeorm -- migration:revert -d ./src/connection/cli-data-source.ts",
    "lint": "eslint --ext .ts --max-warnings=0 .",
    "type-check": "tsc --noEmit",
    "typeorm": "dotenv -e ../apps/api/.env -- node --require ts-node/register ../../node_modules/typeorm/cli.js"
  },
  "types": "./src/index.ts"
}
